#!/usr/bin/env python3
"""Test stand-in for darktable-cli: same command line, writes a tiny valid JPEG.

Markers inside the input file change what it does:
  FAILME  -> exit 1 (as darktable does for a file it can't decode)
  NOOUT   -> exit 0 but write nothing
  BADJPEG -> write a truncated JPEG
  SLOW    -> sleep a long time (for the timeout and cancel tests)
Every call is appended to $PM_STUB_LOG so tests can check how it was run.
"""
import base64
import json
import os
import sys
import time

JPEG = base64.b64decode("")
args = sys.argv[1:]
if args[:1] == ["--version"]:
    print("darktable 4.6.1 (test stub)")
    sys.exit(0)
src, dst = args[0], args[1]
data = open(src, "rb").read()
log = os.environ.get("PM_STUB_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(json.dumps({"args": args, "size": len(data), "src_dir": os.path.dirname(src),
                             "home": os.environ.get("HOME")}) + "\n")
if b"SLOW" in data:
    time.sleep(60)
if b"FAILME" in data:
    print("[stub] cannot decode this file", file=sys.stderr)
    sys.exit(1)
if b"NOOUT" in data:
    sys.exit(0)
if b"BADJPEG" in data:
    open(dst, "wb").write(JPEG[:30])
    sys.exit(0)
open(dst, "wb").write(JPEG)
